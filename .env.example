DATABASE_URL=postgresql://claire:claire@127.0.0.1:5432/claire
# 32 bytes, base64 — generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
DATA_KEY=
PUBLIC_URL=http://127.0.0.1:8000
HOLDOUT_SHARE=0.03
USER_MESSAGE_WORDS=150
POLICY_VERSION=1.0
# Shared secret for /admin (empty disables the UI)
ADMIN_TOKEN=dev-admin
# How long MCP hosts may cache tools/list + resources (ms). After a widget
# deploy, clients see the new ui:// fingerprint once this expires (or on
# reconnect). 0 = always refetch. Default 1 hour.
CACHE_TTL_MS=3600000
