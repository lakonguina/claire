PUBLIC_URL=https://claire.pm
ADMIN_TOKEN=change-me
POSTGRES_PASSWORD=change-me
# 32 random bytes in base64, that encrypt stored texts:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Keep it safe and stable: without it, stored texts cannot be read.
DATA_KEY=
PRIVACY_EMAIL=privacy@claire.pm
# conversation, user, or auto: per conversation below PER_USER_FROM active
# people, per person from there.
CONTROL_UNIT=auto
# Shares of new conversations held back: the holdout is the permanent baseline
# of normal replies; the "be concise" arm is for an opt-in study.
HOLDOUT_SHARE=0.03
CONCISE_SHARE=0
# Share of conversations whose user messages are stored (with consent).
MESSAGE_SAMPLE=0.1
# Share of reached goals followed by "did you get what you needed?".
GROUND_TRUTH_SHARE=0.1
# Days stored texts are kept.
RETENTION_DAYS=1095
# Share of conversations where one tool field is never asked, to measure it.
ABLATION_SHARE=0.1
# Share of conversations on locales/candidate.json's prompts, once it exists
# and has passed `python -m app.evals.instruction`.
CANDIDATE_SHARE=0
# The instruction check calls the assistants' APIs (owner's keys):
EVAL_MODELS=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Extra origins allowed to call /mcp (comma-separated); claude.ai and
# chatgpt.com are allowed by default.
ALLOWED_ORIGINS=
# Development only: uncomment so a plain `docker compose up` reloads code live.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
